cmake_minimum_required(VERSION 3.22)
project(GuitarRackHeadlessVerification LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
get_filename_component(DEFAULT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(ROOT "${DEFAULT_ROOT}" CACHE PATH "GuitarRack checkout")
set(CORE_ARCHIVE "${ROOT}/build/core-release/libguitarrack_core.a" CACHE FILEPATH "Prebuilt core archive")
set(JUCE_MODULES "${ROOT}/build/vendor/JUCE/modules" CACHE PATH "Pinned JUCE modules")
find_package(Threads REQUIRED)
find_package(Python3 COMPONENTS Interpreter REQUIRED)
add_library(guitarrack_core STATIC IMPORTED)
set_target_properties(guitarrack_core PROPERTIES IMPORTED_LOCATION ${CORE_ARCHIVE} INTERFACE_INCLUDE_DIRECTORIES ${ROOT}/src INTERFACE_LINK_LIBRARIES Threads::Threads)
set(JUCE ${JUCE_MODULES})
add_library(juce_core STATIC ${JUCE}/juce_core/juce_core.cpp ${JUCE}/juce_core/juce_core_CompilationTime.cpp)
target_include_directories(juce_core PUBLIC ${JUCE})
target_compile_definitions(juce_core PUBLIC JUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1 JUCE_STANDALONE_APPLICATION=1 JUCE_USE_CURL=0 JUCE_WEB_BROWSER=0 JUCE_MODAL_LOOPS_PERMITTED=1)
target_link_libraries(juce_core PUBLIC Threads::Threads ${CMAKE_DL_LIBS} rt)
add_library(guitarrack_state STATIC ${ROOT}/src/state/Presets.cpp ${ROOT}/src/state/PresetSession.cpp ${ROOT}/src/state/Preferences.cpp ${ROOT}/src/state/Assets.cpp ${ROOT}/src/state/PedalPresets.cpp)
target_link_libraries(guitarrack_state PUBLIC guitarrack_core juce_core)
enable_testing()
foreach(suite IN ITEMS State Asset PedalPreset)
 add_executable(${suite}Tests ${ROOT}/tests/${suite}Tests.cpp ${ROOT}/tests/HeapAudit.cpp)
 target_compile_definitions(${suite}Tests PRIVATE GUITARRACK_SOURCE_DIR="${ROOT}")
 target_link_libraries(${suite}Tests PRIVATE guitarrack_state)
 add_test(NAME ${suite}Tests COMMAND ${suite}Tests)
endforeach()
foreach(tool IN ITEMS export_sound_library legacy_render render_sounds)
 add_executable(${tool} ${ROOT}/tools/${tool}.cpp ${ROOT}/tests/HeapAudit.cpp)
 target_include_directories(${tool} PRIVATE ${ROOT}/tests)
 target_link_libraries(${tool} PRIVATE guitarrack_state)
endforeach()
add_test(NAME legacy_identity_compatibility COMMAND ${Python3_EXECUTABLE} ${ROOT}/tools/check_compatibility.py $<TARGET_FILE:export_sound_library>)
add_test(NAME legacy_audio_compatibility COMMAND ${Python3_EXECUTABLE} ${ROOT}/tools/check_legacy_render.py $<TARGET_FILE:legacy_render>)
