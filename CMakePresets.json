{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 22, "patch": 0},
  "configurePresets": [
    {"name": "linux-debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/linux-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "linux-release", "inherits": "linux-debug", "binaryDir": "${sourceDir}/build/linux-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "core-debug", "inherits": "linux-debug", "binaryDir": "${sourceDir}/build/core-debug", "cacheVariables": {"GUITARRACK_BUILD_STANDALONE": "OFF"}},
    {"name": "core-sanitize", "inherits": "core-debug", "binaryDir": "${sourceDir}/build/core-sanitize", "cacheVariables": {"GUITARRACK_SANITIZERS": "ON"}}
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug", "jobs": 2},
    {"name": "linux-release", "configurePreset": "linux-release", "jobs": 2},
    {"name": "core-debug", "configurePreset": "core-debug"},
    {"name": "core-sanitize", "configurePreset": "core-sanitize"}
  ],
  "testPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}},
    {"name": "core-debug", "configurePreset": "core-debug", "output": {"outputOnFailure": true}},
    {"name": "core-sanitize", "configurePreset": "core-sanitize", "output": {"outputOnFailure": true}}
  ]
}
